{
  "name": "claude-web",
  "version": "1.0.0",
  "description": "Browser front end for Claude Code, driven by the Claude Agent SDK",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "croner": "^10.0.1",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true
}
